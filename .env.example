# ==============================================================================
# TrafficProxy Edge Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values to suit your local environment.
# ==============================================================================

# Deployment environment: DEVELOPMENT (unlocks UI dev console & traffic seeder) or PRODUCTION
ENVIRONMENT=DEVELOPMENT

# Port for the proxy to listen on (default: :80 or custom like :8080)
PROXY_PORT=:8080

# Maximum number of concurrent requests allowed through the semaphore (default: 25)
PROXY_MAX_CONCURRENT=25

# Duration a request waits in the queue before timing out with 503 (default: 500ms)
PROXY_QUEUE_TIMEOUT=500ms

# Polling frequency for discovering containers via Docker daemon (default: 2s)
DOCKER_POLL_INTERVAL=2s

# Log verbosity level: DEBUG, INFO, WARN, ERROR (default: DEBUG)
LOG_LEVEL=DEBUG

# Launch local mock backend containers in Docker (backend-api and backend-slow): true or false (default: false)
WITH_MOCK_BACKENDS=false

# Docker daemon socket/pipe (optional; standard Docker default if omitted)
# DOCKER_HOST=unix:///var/run/docker.sock
