# ==============================================================================
# SanProx Edge Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure all variables for your environment.
# Note: config.go enforces zero fallbacks; all variables must be explicitly defined.
# ==============================================================================

# Deployment environment profile: DEVELOPMENT (enables dev tools, seeder, stress) or PRODUCTION
ENVIRONMENT=DEVELOPMENT

# Port for the gateway to listen on (e.g. :80 or :8080)
PROXY_PORT=:8080

# Docker Engine socket endpoint or named pipe (e.g. /var/run/docker.sock or unix:///var/run/docker.sock)
DOCKER_HOST=/var/run/docker.sock

# Maximum concurrent requests allowed through the concurrency semaphore
PROXY_MAX_CONCURRENT=25

# Duration a request waits in the concurrency queue before rejecting with HTTP 503
PROXY_QUEUE_TIMEOUT=500ms

# Polling frequency for discovering labeled containers via Docker Engine API
DOCKER_POLL_INTERVAL=2s

# Structured JSON log verbosity level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# Launch local mock backend containers for development (start.ps1 / start.sh): true or false
WITH_MOCK_BACKENDS=false
